<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    tools:context=".MainActivity">

    <!-- Camera Preview (Full Screen Background) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Bar: SpatialSight Title and Streaming Status -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC15370D"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Project Title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SpatialSight"
            android:textColor="@color/brand_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Streaming Status Indicator (visible only when streaming) -->
        <LinearLayout
            android:id="@+id/streamingIndicatorLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <View
                android:id="@+id/dotStreaming"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_green"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtStreamingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streaming"
                android:textColor="@color/brand_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- FPS / Telemetry Badge -->
        <TextView
            android:id="@+id/txtFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_muted"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginStart="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Centered Action Button: [Start Streaming] / [Stop Streaming] -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnToggleStream"
        android:layout_width="260dp"
        android:layout_height="60dp"
        android:text="Start Streaming"
        android:textColor="@color/brand_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/button_border_gold"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Instruction Footnote -->
    <TextView
        android:id="@+id/txtInstructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADB Port Forward: localhost:8080"
        android:textColor="@color/brand_text_muted"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
